{
  "name": "hook-stage-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter hook-stage dev",
    "dev:web": "pnpm --filter @hook-stage/web dev",
    "demo": "concurrently -n server,web,buggy,fixed -c blue,magenta,yellow,green \"pnpm dev:server\" \"pnpm dev:web\" \"pnpm receiver:buggy\" \"pnpm receiver:fixed\"",
    "receiver:buggy": "pnpm --filter @hook-stage/order-receiver exec tsx src/main.ts --mode buggy --port 3000",
    "receiver:fixed": "pnpm --filter @hook-stage/order-receiver exec tsx src/main.ts --mode fixed --port 3001",
    "build": "pnpm --filter @hook-stage/web build && pnpm --filter hook-stage build",
    "start": "pnpm --filter hook-stage start",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/scenario --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit && tsc -p examples/order-receiver --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hook-stage/scenario": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
